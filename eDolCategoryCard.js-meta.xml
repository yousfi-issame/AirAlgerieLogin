function buildCommunityUrl(path) {
    if (!path || path === '/') {
        return basePath || '/';
    }
    if (/^https?:\/\//i.test(path)) {
        return path;
    }

    const cleanBase = basePath && basePath !== '/' ? basePath.replace(/\/$/, '') : '';
    const cleanPath = path.startsWith('/') ? path : `/${path}`;

    if (cleanBase && (cleanPath === cleanBase || cleanPath.startsWith(`${cleanBase}/`))) {
        return cleanPath;
    }

    return `${cleanBase}${cleanPath}` || '/';
}


function getCaseNumberFromUrl() {
    try {
        const params = new URLSearchParams(window.location.search || '');
        const rawValue = params.get('casenumber') || params.get('caseNumber') || params.get('case') || params.get('reference') || params.get('ref') || '';
        return (rawValue || '').replace(/\D/g, '').slice(0, 12);
    } catch (error) {
        return '';
    }
}

function setCaseNumberInUrl(caseNumber) {
    if (!caseNumber || typeof window === 'undefined' || !window.history || !window.history.replaceState) {
        return;
    }

    try {
        const url = new URL(window.location.href);
        url.searchParams.set('casenumber', caseNumber);
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    } catch (error) {}
}

function clearCaseNumberFromUrl() {
    if (typeof window === 'undefined' || !window.history || !window.history.replaceState) {
        return;
    }

    try {
        const url = new URL(window.location.href);
        ['casenumber', 'caseNumber', 'case', 'reference', 'ref'].forEach((key) => url.searchParams.delete(key));
        const query = url.searchParams.toString();
        window.history.replaceState({}, '', `${url.pathname}${query ? `?${query}` : ''}${url.hash}`);
    } catch (error) {}
}

