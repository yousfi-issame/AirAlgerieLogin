export default class EDolTrackComplaint extends LightningElement {
    @api complaintPageUrl = '/';

    selectedLanguage = 'en';
    caseNumber = '';
    caseNumberError = '';
    isLoading = false;
    result = null;
    errorMessage = '';
    errorModalOpen = false;

    get labels() {
        return TEXT[this.selectedLanguage] || TEXT.en;
    }

    get pageClass() {
        return this.selectedLanguage === 'ar' ? 'trackPage categoryPage edol-force-rtl' : 'trackPage categoryPage edol-force-ltr';
    }

    get heroBackgroundStyle() {
        return `background-image: linear-gradient(90deg, rgba(255,255,225,.14), rgba(218,245,250,.08)), url(${heroBackground});`;
    }

    get submitLabel() {
        return this.isLoading ? this.labels.searching : this.labels.search;
    }

    get caseNumberFieldClass() {
        return this.caseNumberError ? 'edol-field edol-field-error' : 'edol-field';
    }

    get hasResult() {
        return this.result !== null;
    }

    get trackingFound() {
        return this.result && this.result.found === true;
    }

    get referenceStepClass() {
        if (this.trackingFound) {
            return 'progressStep completed';
        }
        return 'progressStep active';
    }

    get statusStepClass() {
        if (this.trackingFound) {
            return 'progressStep active';
        }
        if (this.hasResult) {
            return 'progressStep completed';
        }
        return 'progressStep';
    }

    get followUpStepClass() {
        return 'progressStep';
    }

    get resultDescription() {
        return this.result && this.result.description ? this.result.description : this.labels.noDescription;
    }

    connectedCallback() {
        const initialLanguage = getInitialLanguage();
        this.selectedLanguage = TEXT[initialLanguage] ? initialLanguage : 'en';

        const urlCaseNumber = getCaseNumberFromUrl();
        if (urlCaseNumber) {
            this.caseNumber = urlCaseNumber;
            window.setTimeout(() => {
                this.handleSubmit({ preventDefault() {} });
            }, 0);
        }
    }

    handleLanguageChange(event) {
        const language = event.detail && event.detail.language ? event.detail.language : 'en';
        this.selectedLanguage = TEXT[language] ? language : 'en';
        try {
            window.localStorage.setItem('edolLanguage', this.selectedLanguage);
        } catch (error) {}
    }

    handleCaseNumberChange(event) {
        this.caseNumber = (event.target.value || '').replace(/\D/g, '').slice(0, 12);
        event.target.value = this.caseNumber;
        this.caseNumberError = '';
    }

    validate() {
        const value = (this.caseNumber || '').trim();
        if (!value) {
            this.caseNumberError = this.labels.required;
            this.scrollToField();
            return false;
        }
        if (!/^\d{4,12}$/.test(value)) {
            this.caseNumberError = this.labels.invalid;
            this.scrollToField();
            return false;
        }
        this.caseNumberError = '';
        return true;
    }

    scrollToField() {
        window.setTimeout(() => {
            const field = this.template.querySelector('.edol-field-error');
            if (field) {
                field.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }, 0);
    }

    async handleSubmit(event) {
        event.preventDefault();
        if (!this.validate() || this.isLoading) {
            return;
        }

        this.isLoading = true;
        this.result = null;
        setCaseNumberInUrl(this.caseNumber);

        try {
            const response = await trackComplaint({ caseNumber: this.caseNumber });
            this.result = response;
            setCaseNumberInUrl(this.caseNumber);
        } catch (error) {
            this.showError(this.extractErrorMessage(error));
        } finally {
            this.isLoading = false;
        }
    }

    extractErrorMessage(error) {
        if (error && error.body && error.body.message) {
            return error.body.message;
        }
        if (error && error.message) {
            return error.message;
        }
        return this.labels.technicalError;
    }

    showError(message) {
        this.errorMessage = message || this.labels.technicalError;
        this.errorModalOpen = true;
    }

    closeError() {
        this.errorMessage = '';
        this.errorModalOpen = false;
    }

    resetSearch() {
        this.result = null;
        this.caseNumberError = '';
        clearCaseNumberFromUrl();
        window.setTimeout(() => {
            const input = this.template.querySelector('input[name="caseNumber"]');
            if (input) {
                input.focus();
            }
        }, 0);
    }

    goBack() {
        window.location.assign(buildCommunityUrl(this.complaintPageUrl || '/'));
    }
}
