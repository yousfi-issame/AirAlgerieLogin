import { LightningElement, api } from 'lwc';
import basePath from '@salesforce/community/basePath';
import background from '@salesforce/resourceUrl/SiteBackground';
import mainWindow from '@salesforce/resourceUrl/MainWindow';
import { getText, getInitialLanguage } from 'c/eDolFormData';

function buildCommunityUrl(path) {
    if (!path || path === '/') {
        return basePath || '/';
    }
    if (/^https?:\/\//i.test(path)) {
        return path;
    }

    const cleanBase = basePath && basePath !== '/' ? basePath.replace(/\/$/, '') : '';
    const cleanPath = path.startsWith('/') ? path : `/${path}`;

    if (cleanBase && (cleanPath === cleanBase || cleanPath.startsWith(`${cleanBase}/`))) {
        return cleanPath;
    }

    return `${cleanBase}${cleanPath}` || '/';
}

export default class EDolHomePage extends LightningElement {
    // Keep this property name. It is already referenced by the published Experience Builder page.
    // Renaming/removing it causes deployment errors until the component is removed from the page.
    @api complaintsUrl = '/forms';
    @api trackUrl = '/forms/track-complaint';

    selectedLanguage = 'en';
    homeVisualUrl = mainWindow;

    get text() { return getText(this.selectedLanguage); }
    get pageClass() { return 'homePage edol-force-ltr'; }
    get backgroundStyle() { return `background-image: linear-gradient(90deg, rgba(242,255,245,.84), rgba(218,245,250,.88)), url(${background});`; }
    get heroTitleLineOne() { return this.text.homeTitle.split('\n')[0]; }
    get heroTitleLineTwo() { return this.text.homeTitle.split('\n')[1]; }

    connectedCallback() {
        this.selectedLanguage = getInitialLanguage();
    }

    setStoredLanguage(language) {
        try {
            window.localStorage.setItem('edolLanguage', language);
        } catch (error) {
            // Ignore localStorage restrictions in strict browser contexts.
        }
    }

    handleLanguageChange(event) {
        this.selectedLanguage = event.detail.language;
        this.setStoredLanguage(event.detail.language);
    }

    goToComplaints() {
        window.location.assign(buildCommunityUrl(this.complaintsUrl || '/forms')); 
    }

    goToTrackComplaint() {
        window.location.assign(buildCommunityUrl(this.trackUrl || '/forms/track-complaint'));
    }
}
