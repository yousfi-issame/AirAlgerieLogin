public without sharing class EDolSubmissionController {
    private static final String DEFAULT_ORIGIN = 'E-DOL';
    private static final String DEFAULT_CUSTOMER_SOURCE = 'E-DOL';

    @AuraEnabled
    public static SubmissionResult submitComplaint(SubmissionRequest request) {
        try {
            validateRequest(request);

            Map<String, Object> values = request.values == null ? new Map<String, Object>() : request.values;
            Account accountRecord = findOrCreatePersonAccount(values, request.language);
            Id contactId = getPersonContactId(accountRecord.Id);

            Case caseRecord = buildCase(request, values, accountRecord.Id, contactId);
            insert caseRecord;

            createTickets(request.tickets, caseRecord.Id, accountRecord.Id);
            uploadFiles(request.files, caseRecord.Id);

            Case createdCase = [
                SELECT Id, CaseNumber
                FROM Case
                WHERE Id = :caseRecord.Id
                LIMIT 1
            ];

            SubmissionResult result = new SubmissionResult();
            result.success = true;
            result.accountId = accountRecord.Id;
            result.contactId = contactId;
            result.caseId = createdCase.Id;
            result.caseNumber = createdCase.CaseNumber;
            return result;
        } catch (AuraHandledException handledError) {
            throw handledError;
        } catch (Exception error) {
            throw new AuraHandledException('Unable to submit the complaint: ' + error.getMessage());
        }
    }


    @AuraEnabled(cacheable=false)
    public static AccountPrefillResult findPersonAccountForPrefill(String email, String mobilePhone) {
        try {
            AccountPrefillResult result = new AccountPrefillResult();
            String normalizedEmail = normalizeEmail(email);
            String normalizedPhone = normalizePhone(mobilePhone);

            if (isBlank(normalizedEmail) || isBlank(normalizedPhone)) {
                result.found = false;
                result.values = new Map<String, Object>();
                return result;
            }

            Account accountRecord = findExistingPersonAccount(normalizedEmail, normalizedPhone);
            if (accountRecord == null) {
                result.found = false;
                result.values = new Map<String, Object>{
                    'email' => normalizedEmail,
                    'confirmEmail' => normalizedEmail,
                    'mobilePhone' => normalizedPhone
                };
                return result;
            }

            result.found = true;
            result.accountId = accountRecord.Id;
            result.values = buildPrefillValues(accountRecord, normalizedEmail, normalizedPhone);
            return result;
        } catch (AuraHandledException handledError) {
            throw handledError;
        } catch (Exception error) {
            throw new AuraHandledException('Unable to search the customer information: ' + error.getMessage());
        }
    }

    private static void validateRequest(SubmissionRequest request) {
        if (request == null) {
            throw new AuraHandledException('Missing submission data.');
        }
        if (request.captchaVerified != true) {
            throw new AuraHandledException('Captcha verification is required.');
        }
        if (request.values == null) {
            throw new AuraHandledException('Missing form values.');
        }

        List<String> requiredFields = new List<String>{ 'firstName', 'lastName', 'email', 'mobilePhone' };
        for (String fieldName : requiredFields) {
            if (isBlank(str(request.values.get(fieldName)))) {
                throw new AuraHandledException('Missing required field: ' + fieldName);
            }
        }

        if (!isTrue(request.values.get('consentAccepted'))) {
            throw new AuraHandledException('Personal data consent is required.');
        }
    }

    private static Account findOrCreatePersonAccount(Map<String, Object> values, String submittedLanguage) {
        String email = normalizeEmail(str(values.get('email')));
        String mobilePhone = normalizePhone(str(values.get('mobilePhone')));

        Account existingAccount = findExistingPersonAccount(email, mobilePhone);
        if (existingAccount != null) {
            // Existing Person Accounts are reused only.
            // We intentionally do not update account master data from the public form.
            return existingAccount;
        }

        Account accountRecord = new Account();
        accountRecord.RecordTypeId = getPersonAccountRecordTypeId();
        applyAccountFormValues(accountRecord, values, submittedLanguage, true);

        Database.SaveResult saveResult = Database.insert(accountRecord, false);
        if (!saveResult.isSuccess()) {
            String message = collectErrors(saveResult.getErrors());
            throw new AuraHandledException('Unable to create Person Account: ' + message);
        }

        return [
            SELECT Id
            FROM Account
            WHERE Id = :saveResult.getId()
            LIMIT 1
        ];
    }

    private static Account findExistingPersonAccount(String email, String mobilePhone) {
        if (isBlank(email) || isBlank(mobilePhone)) {
            return null;
        }

        List<String> selectFields = new List<String>{ 'Id' };
        Map<String, Schema.SObjectField> accountFields = Account.SObjectType.getDescribe().fields.getMap();
        if (accountFields.containsKey('PersonContactId')) {
            selectFields.add('PersonContactId');
        }
        if (accountFields.containsKey('PersonEmail')) {
            selectFields.add('PersonEmail');
        }
        if (accountFields.containsKey('PersonMobilePhone')) {
            selectFields.add('PersonMobilePhone');
        }
        if (accountFields.containsKey('Phone')) {
            selectFields.add('Phone');
        }
        if (accountFields.containsKey('PersonBirthdate')) {
            selectFields.add('PersonBirthdate');
        }
        if (accountFields.containsKey('Languages__pc')) {
            selectFields.add('Languages__pc');
        }
        if (accountFields.containsKey('Customer_Source__pc')) {
            selectFields.add('Customer_Source__pc');
        }
        if (accountFields.containsKey('Customer_Source__c')) {
            selectFields.add('Customer_Source__c');
        }
        if (accountFields.containsKey('FirstName')) {
            selectFields.add('FirstName');
        }
        if (accountFields.containsKey('LastName')) {
            selectFields.add('LastName');
        }
        if (accountFields.containsKey('PersonTitle')) {
            selectFields.add('PersonTitle');
        }
        if (accountFields.containsKey('PersonMailingStreet')) {
            selectFields.add('PersonMailingStreet');
        }
        if (accountFields.containsKey('PersonMailingPostalCode')) {
            selectFields.add('PersonMailingPostalCode');
        }
        if (accountFields.containsKey('PersonMailingState')) {
            selectFields.add('PersonMailingState');
        }
        if (accountFields.containsKey('PersonMailingCountry')) {
            selectFields.add('PersonMailingCountry');
        }
        if (accountFields.containsKey('BillingStreet')) {
            selectFields.add('BillingStreet');
        }
        if (accountFields.containsKey('BillingPostalCode')) {
            selectFields.add('BillingPostalCode');
        }
        if (accountFields.containsKey('BillingState')) {
            selectFields.add('BillingState');
        }
        if (accountFields.containsKey('BillingCountry')) {
            selectFields.add('BillingCountry');
        }

        String query = 'SELECT ' + String.join(selectFields, ',') +
            ' FROM Account WHERE IsPersonAccount = true AND PersonEmail = :email AND PersonMobilePhone = :mobilePhone LIMIT 1';
        List<SObject> rows = Database.query(query);
        if (rows.isEmpty()) {
            return null;
        }
        return (Account) rows[0];
    }


    private static Map<String, Object> buildPrefillValues(Account accountRecord, String fallbackEmail, String fallbackPhone) {
        Map<String, Object> values = new Map<String, Object>();

        String email = firstNonBlank(new List<String>{ str(accountRecord.get('PersonEmail')), fallbackEmail });
        String mobilePhone = firstNonBlank(new List<String>{ str(accountRecord.get('PersonMobilePhone')), fallbackPhone });
        String landlinePhone = firstNonBlank(new List<String>{ str(accountRecord.get('Phone')) });
        String countryName = firstNonBlank(new List<String>{ str(accountRecord.get('PersonMailingCountry')), str(accountRecord.get('BillingCountry')) });
        String regionName = firstNonBlank(new List<String>{ str(accountRecord.get('PersonMailingState')), str(accountRecord.get('BillingState')) });

        values.put('firstName', str(accountRecord.get('FirstName')));
        values.put('lastName', str(accountRecord.get('LastName')));
        values.put('email', email);
        values.put('confirmEmail', email);
        values.put('mobilePhone', mobilePhone);
        values.put('landlinePhone', landlinePhone);
        values.put('civility', mapTitleToCivility(str(accountRecord.get('PersonTitle'))));
        values.put('dateOfBirth', accountRecord.get('PersonBirthdate') == null ? null : String.valueOf(accountRecord.get('PersonBirthdate')));
        values.put('countryOfResidence', mapCountryCodeFromName(countryName));
        values.put('regionOfResidence', mapRegionCodeFromName(regionName));
        values.put('addressOfResidence', firstNonBlank(new List<String>{ str(accountRecord.get('PersonMailingStreet')), str(accountRecord.get('BillingStreet')) }));
        values.put('postalCode', firstNonBlank(new List<String>{ str(accountRecord.get('PersonMailingPostalCode')), str(accountRecord.get('BillingPostalCode')) }));
        return values;
    }

    private static String mapTitleToCivility(String title) {
        if (isBlank(title)) {
            return null;
        }
        String normalized = title.trim().toLowerCase();
        if (normalized == 'mr' || normalized == 'mr.' || normalized == 'monsieur') {
            return 'mr';
        }
        if (normalized == 'mrs' || normalized == 'mrs.' || normalized == 'madame' || normalized == 'ms' || normalized == 'ms.') {
            return 'mrs';
        }
        return null;
    }

