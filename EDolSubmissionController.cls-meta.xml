    private static String firstNonBlank(List<String> values) {
        if (values == null) {
            return null;
        }
        for (String value : values) {
            if (!isBlank(value)) {
                return value;
            }
        }
        return null;
    }

    private static Id getPersonAccountRecordTypeId() {
        List<SObject> rows = Database.query(
            'SELECT Id FROM RecordType WHERE SObjectType = \'Account\' AND IsPersonType = true LIMIT 1'
        );
        if (rows.isEmpty()) {
            throw new AuraHandledException('No Person Account record type was found. Please enable/configure Person Accounts first.');
        }
        return (Id) rows[0].get('Id');
    }

    private static Id getPersonContactId(Id accountId) {
        if (accountId == null || !Account.SObjectType.getDescribe().fields.getMap().containsKey('PersonContactId')) {
            return null;
        }
        List<SObject> rows = Database.query('SELECT PersonContactId FROM Account WHERE Id = :accountId LIMIT 1');
        if (rows.isEmpty()) {
            return null;
        }
        return (Id) rows[0].get('PersonContactId');
    }

    private static Case buildCase(SubmissionRequest request, Map<String, Object> values, Id accountId, Id contactId) {
        String category = mapCategory(request.categoryId);
        String subcategory = mapSubcategory(request.categoryId, str(values.get('reason')), str(values.get('ticketPurchaseChannel')));
        String submittedLanguage = toSalesforceLanguage(request.language);
        String submittedCountry = mapCountry(str(values.get('countryOfResidence')));
        String fullName = buildFullName(str(values.get('firstName')), str(values.get('lastName')));

        Case caseRecord = new Case();
        caseRecord.AccountId = accountId;
        if (contactId != null) {
            caseRecord.ContactId = contactId;
        }
        caseRecord.Origin = DEFAULT_ORIGIN;
        caseRecord.Subject = buildSubject(fullName, category);
        caseRecord.Description = truncate(str(values.get('details')), 32000);

        setPicklistIfValid(caseRecord, 'Complaint_Category__c', category, 'Other');
        setPicklistIfValid(caseRecord, 'Complaint_Subcategory__c', subcategory, 'Other');
        setPicklistIfValid(caseRecord, 'Submitted_Language__c', submittedLanguage, null);
        setPicklistIfValid(caseRecord, 'Submitted_Country__c', submittedCountry, 'Other');
        setPicklistIfValid(caseRecord, 'Region_of_residence__c', mapRegion(str(values.get('regionOfResidence'))), 'Other');

        setPicklistIfValid(caseRecord, 'Business_Routing__c', mapBusinessRouting(request.categoryId), 'Other');
        setPicklistIfValid(caseRecord, 'Region_Routing__c', mapRegion(str(values.get('regionOfResidence'))), 'Other');
        setPicklistIfValid(caseRecord, 'Routing_Mode__c', mapRoutingMode(request.categoryId, str(values.get('regionOfResidence'))), null);
        setPicklistIfValid(caseRecord, 'Claimant_Type__c', mapClaimantType(str(values.get('claimantType'))), null);

        setIfFieldExists(caseRecord, 'Captcha_Verified__c', request.captchaVerified == true);
        setIfFieldExists(caseRecord, 'Consent_Accepted__c', isTrue(values.get('consentAccepted')));
        setIfFieldExists(caseRecord, 'External_Submission_Id__c', generateExternalSubmissionId(request.categoryId));

        return caseRecord;
    }

    private static void createTickets(List<TicketRequest> tickets, Id caseId, Id accountId) {
        if (tickets == null || tickets.isEmpty()) {
            return;
        }

        Schema.SObjectType ticketType = Schema.getGlobalDescribe().get('Ticket__c');
        if (ticketType == null) {
            throw new AuraHandledException('Ticket__c object was not found. Please create the Ticket custom object first.');
        }

        Map<String, Schema.SObjectField> ticketFields = ticketType.getDescribe().fields.getMap();
        if (!ticketFields.containsKey('Case__c')) {
            throw new AuraHandledException('Ticket__c is missing the Case__c lookup field.');
        }
        if (!ticketFields.containsKey('Passenger__c')) {
            throw new AuraHandledException('Ticket__c is missing the Passenger__c lookup field.');
        }
        if (!ticketFields.containsKey('Details__c')) {
            throw new AuraHandledException('Ticket__c is missing the Details__c long text field.');
        }

        List<SObject> records = new List<SObject>();
        for (TicketRequest ticket : tickets) {
            if (ticket == null) {
                continue;
            }

            String ticketNumber = normalizeTicketNumber(ticket);
            if (isBlank(ticketNumber)) {
                continue;
            }

            SObject record = ticketType.newSObject();
            record.put('Name', truncate(ticketNumber, 80));
            record.put('Case__c', caseId);
            record.put('Passenger__c', accountId);
            record.put('Details__c', str(ticket.details));

            records.add(record);
        }

        if (!records.isEmpty()) {
            Database.SaveResult[] results = Database.insert(records, false);
            List<String> errors = new List<String>();
            for (Database.SaveResult result : results) {
                if (!result.isSuccess()) {
                    errors.add(collectErrors(result.getErrors()));
                }
            }
            if (!errors.isEmpty()) {
                throw new AuraHandledException('The complaint was created, but ticket creation failed: ' + String.join(errors, ' | '));
            }
        }
    }

    private static Boolean applyAccountFormValues(Account accountRecord, Map<String, Object> values, String submittedLanguage, Boolean overwriteExisting) {
        Boolean changed = false;
        String submittedCountry = mapCountry(str(values.get('countryOfResidence')));
        String submittedRegion = mapRegion(str(values.get('regionOfResidence')));

        changed = setTextIfChanged(accountRecord, 'FirstName', str(values.get('firstName')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'LastName', str(values.get('lastName')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonEmail', normalizeEmail(str(values.get('email'))), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonMobilePhone', str(values.get('mobilePhone')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'Phone', str(values.get('landlinePhone')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonTitle', mapCivilityToTitle(str(values.get('civility'))), overwriteExisting) || changed;

        changed = setDateIfChanged(accountRecord, 'PersonBirthdate', parseDate(str(values.get('dateOfBirth'))), overwriteExisting) || changed;

        changed = setPicklistIfChanged(accountRecord, 'Languages__pc', toSalesforceLanguage(submittedLanguage), null, overwriteExisting) || changed;
        changed = setPicklistIfChanged(accountRecord, 'Customer_Source__pc', DEFAULT_CUSTOMER_SOURCE, null, overwriteExisting) || changed;
        changed = setPicklistIfChanged(accountRecord, 'Customer_Source__c', DEFAULT_CUSTOMER_SOURCE, null, overwriteExisting) || changed;

        changed = setTextIfChanged(accountRecord, 'PersonMailingStreet', str(values.get('addressOfResidence')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonMailingPostalCode', str(values.get('postalCode')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonMailingState', submittedRegion, overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'PersonMailingCountry', submittedCountry, overwriteExisting) || changed;

        changed = setTextIfChanged(accountRecord, 'BillingStreet', str(values.get('addressOfResidence')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'BillingPostalCode', str(values.get('postalCode')), overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'BillingState', submittedRegion, overwriteExisting) || changed;
        changed = setTextIfChanged(accountRecord, 'BillingCountry', submittedCountry, overwriteExisting) || changed;

        return changed;
    }

    private static void uploadFiles(List<FileRequest> files, Id caseId) {
        if (files == null || files.isEmpty() || caseId == null) {
            return;
        }

        List<ContentVersion> versions = new List<ContentVersion>();
        for (FileRequest file : files) {
            if (file == null || isBlank(file.fileName) || isBlank(file.base64Data)) {
                continue;
            }

            String cleanBase64 = cleanBase64Payload(file.base64Data);
            if (isBlank(cleanBase64)) {
                continue;
            }

            ContentVersion version = new ContentVersion();
            version.Title = truncate(fileTitle(file.fileName), 255);
            version.PathOnClient = truncate(safeFileName(file.fileName), 500);
            version.VersionData = EncodingUtil.base64Decode(cleanBase64);
            version.FirstPublishLocationId = caseId;
            versions.add(version);
        }

        if (versions.isEmpty()) {
            return;
        }

        Database.SaveResult[] results = Database.insert(versions, false);
        List<String> errors = new List<String>();
        for (Database.SaveResult result : results) {
            if (!result.isSuccess()) {
                errors.add(collectErrors(result.getErrors()));
            }
        }
        if (!errors.isEmpty()) {
            throw new AuraHandledException('The complaint was created, but file upload failed: ' + String.join(errors, ' | '));
        }
    }

    private static String buildSubject(String fullName, String category) {
        return truncate(fullName + ' - E-DOL - ' + category + ' - ' + String.valueOf(Date.today()), 255);
    }

    private static String buildDescription(SubmissionRequest request, Map<String, Object> values, String category, String subcategory, String submittedCountry) {
        List<String> lines = new List<String>();
        lines.add('E-DOL complaint submission');
        lines.add('Category: ' + category);
        if (!isBlank(subcategory)) {
            lines.add('Subcategory: ' + subcategory);
        }
        lines.add('Submitted language: ' + toSalesforceLanguage(request.language));
        if (!isBlank(submittedCountry)) {
            lines.add('Submitted country: ' + submittedCountry);
        }
        addLine(lines, 'Claimant type', values.get('claimantType'));
        addLine(lines, 'Civility', values.get('civility'));
        addLine(lines, 'Region of residence', values.get('regionOfResidence'));
        addLine(lines, 'Address of residence', values.get('addressOfResidence'));
        addLine(lines, 'Postal code', values.get('postalCode'));
        addLine(lines, 'Incident location', values.get('incidentLocation'));
        addLine(lines, 'Flight number', values.get('flightNumber'));
        addLine(lines, 'Flight date', values.get('flightDate'));
        addLine(lines, 'PIR file number', values.get('pirFileNumber'));
        addLine(lines, 'Complaint filed date', values.get('complaintFiledDate'));
        addLine(lines, 'Reception quality', values.get('receptionQuality'));
        addLine(lines, 'Details', values.get('details'));
        addLine(lines, 'File upload session', request.fileUploadSessionKey);
        return truncate(String.join(lines, '\n'), 32000);
    }

    private static void addLine(List<String> lines, String label, Object value) {
        String text = str(value);
        if (!isBlank(text)) {
            lines.add(label + ': ' + text);
        }
    }

    private static String mapCategory(String categoryId) {
        Map<String, String> values = new Map<String, String>{
            'cancellation-delay' => 'Cancellation or delay',
            'denied-boarding' => 'Denied boarding',
            'mishandled-baggage' => 'Mishandled baggage',
            'payment-issue' => 'Payment issue during reservation',
            'services-amenities' => 'Services and amenities',
            'loyalty' => 'Air Algérie Plus members',
            'refund-unused-ticket' => 'Refund for unused or partially used ticket',
            'feedback-suggestions' => 'Feedback and suggestions'
        };
        return values.containsKey(categoryId) ? values.get(categoryId) : 'Other';
    }

    private static String mapSubcategory(String categoryId, String reason, String ticketPurchaseChannel) {
        if (categoryId == 'cancellation-delay') {
            if (reason == 'cancellation' && !isBlank(ticketPurchaseChannel)) {
                Map<String, String> channels = new Map<String, String>{
                    'website-or-app' => 'Ticket purchased on Air Algérie website or app',
                    'contact-center' => 'Ticket purchased via contact center',
                    'agency' => 'Ticket purchased from an Air Algérie agency'
                };
                return channels.containsKey(ticketPurchaseChannel) ? channels.get(ticketPurchaseChannel) : 'Flight cancelled';
            }
            if (reason == 'cancellation') {
                return 'Flight cancelled';
            }
            if (reason == 'delay') {
                return 'Flight delayed';
            }
