    private static String normalizeTicketNumber(TicketRequest ticket) {
        String prefix = isBlank(str(ticket.prefix)) ? '124' : str(ticket.prefix).replaceAll('\\s+', '');
        String numberValue = str(ticket.ticketNumber);

        if (!isBlank(numberValue)) {
            return (prefix + numberValue).replaceAll('\\s+', '');
        }

        String full = str(ticket.fullTicketNumber);
        if (!isBlank(full)) {
            String cleanedFull = full.replaceAll('\\s+', '');
            if (cleanedFull != prefix) {
                return cleanedFull;
            }
        }

        return null;
    }

