    private static String generateExternalSubmissionId(String categoryId) {
        String seed = String.valueOf(DateTime.now().getTime()) + '-' + String.valueOf(Crypto.getRandomInteger()) + '-' + str(categoryId);
        return 'EDOL-' + EncodingUtil.convertToHex(Crypto.generateDigest('SHA1', Blob.valueOf(seed))).substring(0, 20).toUpperCase();
    }

    private static Boolean setTextIfChanged(SObject record, String fieldName, String value, Boolean overwriteExisting) {
        if (isBlank(value) || !hasField(record, fieldName)) {
            return false;
        }
        String currentValue = str(record.get(fieldName));
        if (!overwriteExisting && !isBlank(currentValue)) {
            return false;
        }
        if (currentValue != null && String.valueOf(currentValue) == String.valueOf(value)) {
            return false;
        }
        record.put(fieldName, value);
        return true;
    }

    private static Boolean setDateIfChanged(SObject record, String fieldName, Date value, Boolean overwriteExisting) {
        if (value == null || !hasField(record, fieldName)) {
            return false;
        }
        Object currentValue = record.get(fieldName);
        if (!overwriteExisting && currentValue != null) {
            return false;
        }
        if (currentValue != null && String.valueOf(currentValue) == String.valueOf(value)) {
            return false;
        }
        record.put(fieldName, value);
        return true;
    }

    private static Boolean setPicklistIfChanged(SObject record, String fieldName, String value, String fallbackValue, Boolean overwriteExisting) {
        if (isBlank(value) || !hasField(record, fieldName)) {
            return false;
        }
        String currentValue = str(record.get(fieldName));
        if (!overwriteExisting && !isBlank(currentValue)) {
            return false;
        }
        if (currentValue == value) {
            return false;
        }
        Boolean changed = setPicklistIfValid(record, fieldName, value, fallbackValue);
        return changed && str(record.get(fieldName)) != currentValue;
    }

    private static String cleanBase64Payload(String value) {
        if (isBlank(value)) {
            return null;
        }
        String text = value.trim();
        Integer commaIndex = text.indexOf(',');
        if (text.startsWith('data:') && commaIndex >= 0) {
            text = text.substring(commaIndex + 1);
        }
        return text;
    }

    private static String safeFileName(String fileName) {
        String value = str(fileName);
        if (isBlank(value)) {
            return 'attachment';
        }
        return value.replaceAll('[\\\\/:*?"<>|]', '_');
    }

    private static String fileTitle(String fileName) {
        String value = safeFileName(fileName);
        Integer dotIndex = value.lastIndexOf('.');
        if (dotIndex > 0) {
            return value.substring(0, dotIndex);
        }
        return value;
    }

    private static Boolean setIfFieldExists(SObject record, String fieldName, Object value) {
        if (value == null || !hasField(record, fieldName)) {
            return false;
        }
        record.put(fieldName, value);
        return true;
    }

    private static Boolean setPicklistIfValid(SObject record, String fieldName, String value, String fallbackValue) {
        if (isBlank(value) || !hasField(record, fieldName)) {
            return false;
        }

        Schema.DescribeFieldResult describeField = record.getSObjectType().getDescribe().fields.getMap().get(fieldName).getDescribe();
        if (describeField.getType() != Schema.DisplayType.Picklist) {
            record.put(fieldName, value);
            return true;
        }

        Set<String> allowedValues = new Set<String>();
        for (Schema.PicklistEntry entry : describeField.getPicklistValues()) {
            if (entry.isActive()) {
                allowedValues.add(entry.getValue());
            }
        }

        if (allowedValues.contains(value)) {
            record.put(fieldName, value);
            return true;
        }
        if (!isBlank(fallbackValue) && allowedValues.contains(fallbackValue)) {
            record.put(fieldName, fallbackValue);
            return true;
        }
        return false;
    }

    private static Boolean hasField(SObject record, String fieldName) {
        return record != null && record.getSObjectType().getDescribe().fields.getMap().containsKey(fieldName);
    }

    private static String firstExistingField(SObject record, List<String> fieldNames) {
        Map<String, Schema.SObjectField> fields = record.getSObjectType().getDescribe().fields.getMap();
        for (String fieldName : fieldNames) {
            if (fields.containsKey(fieldName)) {
                return fieldName;
            }
        }
        return null;
    }

    private static Date parseDate(String value) {
        if (isBlank(value)) {
            return null;
        }
        try {
            return Date.valueOf(value);
        } catch (Exception error) {
            return null;
        }
    }

    private static String collectErrors(Database.Error[] errors) {
        List<String> messages = new List<String>();
        for (Database.Error error : errors) {
            messages.add(error.getMessage());
        }
        return String.join(messages, ' | ');
    }

    private static String str(Object value) {
        if (value == null) {
            return null;
        }
        String text = String.valueOf(value);
        return text == null ? null : text.trim();
    }

    private static Boolean isTrue(Object value) {
        if (value == null) {
            return false;
        }
        if (value instanceof Boolean) {
            return (Boolean) value;
        }
        String text = String.valueOf(value).trim().toLowerCase();
        return text == 'true' || text == '1' || text == 'yes' || text == 'on';
    }

    private static Boolean isBlank(String value) {
        return value == null || value.trim().length() == 0;
    }

    private static String truncate(String value, Integer maxLength) {
        if (value == null) {
            return null;
        }
        return value.length() > maxLength ? value.substring(0, maxLength) : value;
    }

